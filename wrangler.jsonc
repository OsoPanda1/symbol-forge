{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "symbol-forge",
  "main": "src/server.ts",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "RATE_LIMIT_MAX": "30",
    "RATE_LIMIT_WINDOW": "60"
  },
  "env": {
    "development": {
      "name": "symbol-forge-dev",
      "vars": {
        "APP_ENV": "development"
      }
    },
    "staging": {
      "name": "symbol-forge-staging",
      "vars": {
        "APP_ENV": "staging"
      }
    },
    "production": {
      "name": "symbol-forge-prod",
      "vars": {
        "APP_ENV": "production"
      }
    }
  }
}
